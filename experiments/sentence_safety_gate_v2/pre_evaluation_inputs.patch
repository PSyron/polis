+                    raise ValueError("report cannot contain case or text evidence")
+                if _PRIVATE_PATH.search(key):
+                    raise ValueError("report cannot contain a private path")
+                inspect(child)
+        elif isinstance(value, list | tuple):
+            for child in value:
