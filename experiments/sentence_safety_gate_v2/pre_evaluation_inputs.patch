+@dataclass(frozen=True, slots=True)
+class GateConfig:
+    """Closed v2 identity and quality-gate configuration."""
+
+    schema_version: int
+    experiment_id: str
+    sentence_only: bool
+    platform_profile: str
+    source_policy_version: str
+    corpus_id: str
